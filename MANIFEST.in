include 项目文档/LICENSE 项目文档/README.md 项目文档/ORIGIN.md 项目文档/DEFENSIVE_SCOPE.md 项目文档/VALIDATION.md SOURCE_AUDIT.json requirements-dev.txt
recursive-include src *.py py.typed
recursive-include tests *.py
recursive-include scripts *.py
recursive-include examples *.json *.zip *.tar.gz
include .github/workflows/ci.yml
exclude .DS_Store
prune validation-local
prune .venv
prune .install-check
prune build
prune dist

# Current formal source inventory, including provenance and tests.
include .github/workflows/ci.yml
include .gitignore
include 项目文档/DEFENSIVE_SCOPE.md
include 项目文档/LICENSE
include 项目文档/ORIGIN.md
include 项目文档/README.md
include SOURCE_AUDIT.json
include SOURCE_REVIEW_MANIFEST.json
include 项目文档/VALIDATION.md
include examples/release-manifest.json
include examples/sample-corrupt.zip
include examples/sample-extra.zip
include examples/sample-source.tar.gz
include examples/sample-source.zip
include examples/self-manifest.json
include pyproject.toml
include requirements-dev.txt
include scripts/generate_examples.py
include scripts/installed_cli_check.py
include scripts/installed_smoke.py
include scripts/self_sdist_check.py
include scripts/verify_package.py
include src/source_release_review/__init__.py
include src/source_release_review/__main__.py
include src/source_release_review/cli.py
include src/source_release_review/files.py
include src/source_release_review/py.typed
include src/source_release_review/review.py
include tests/conftest.py
include tests/test_files_cli.py
include tests/test_inventory.py
include tests/test_manifest.py
include tests/test_provenance.py
include tests/test_reader_capabilities.py
include tests/test_structures.py

# Directory layout: canonical docs and source build entry; generated trees are not sdist inputs.
graft 项目文档
include 构建.py 构建配置.json
prune Build/源码
prune Build/新构建
prune Build/输出
prune Build/环境
prune Build/缓存
prune Build/中间
prune Build/临时
global-exclude __pycache__ *.py[cod] .DS_Store

# Original logical paths exist only in the staged compatibility view.
include DEFENSIVE_SCOPE.md LICENSE ORIGIN.md README.md VALIDATION.md
